[Unit]
Description=MarketRadarAI scanner service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ahmtakcm/MarketRadarAI
ExecStart=/home/ahmtakcm/MarketRadarAI/venv/bin/python -u /home/ahmtakcm/MarketRadarAI/main.py
Restart=on-failure
RestartSec=5
Environment=MARKETRADAR_LOG_LEVEL=INFO
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
